{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --omit=optional",
  "buildCommand": "npm run build:demo",
  "outputDirectory": "dist",
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "Permissions-Policy", "value": "xr-spatial-tracking=(self), microphone=(self)" }] }
  ]
}
